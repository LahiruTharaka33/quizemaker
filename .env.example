# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# PostgreSQL (e.g. Neon). Leave empty to store data in data.json instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Public address of the site (used in password-reset links)
APP_URL=

# Optional: only people with this code can create lecturer accounts
INVITE_CODE=

# Optional: mail server for password-reset emails
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
